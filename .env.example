# PostgreSQL used by local Go commands.
POSTGRES_USER=mip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mip
POSTGRES_PORT=5432
DATABASE_URL=postgres://mip:change-me@localhost:5432/mip?sslmode=disable

# Required for Sprint 1.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# Reserved for the realtime scanner in Sprint 6; not consumed yet.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

HTTP_TIMEOUT=15s
DB_MAX_CONNS=10
DB_MIN_CONNS=2
LOG_LEVEL=info
