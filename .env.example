# PostgreSQL used by local Go commands.
POSTGRES_USER=mip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mip
POSTGRES_PORT=5432
DATABASE_URL=postgres://mip:change-me@localhost:5432/mip?sslmode=disable

# Required by ETL and intelligence ingestion.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# Optional real-time Benzinga news fast path through Alpaca Market Data.
# Paper-account API keys are valid for Market Data authentication.
ALPACA_NEWS_ENABLED=false
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_NEWS_STREAM_URL=wss://stream.data.alpaca.markets/v1beta1/news

# Required by realtime Webull snapshot polling.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_BASE_URL=https://api.webull.co.th
# Thailand Trading and Account APIs use the same regional production host.
WEBULL_TRADING_BASE_URL=https://api.webull.co.th
WEBULL_MQTT_URL=wss://data-api.webull.co.th:8883/mqtt
# Required by Thailand OpenAPI after the first-call 2FA flow.
WEBULL_ACCESS_TOKEN=
WEBULL_ACCESS_TOKEN_FILE=.secrets/webull-token.txt
WEBULL_SIGNATURE_ALGORITHM=HMAC-SHA256

# Required by SEC EDGAR. Include an application/contact identity.
SEC_USER_AGENT=
SEC_BASE_URL=https://data.sec.gov

# Optional LLM analysis layer. Any Responses-compatible HTTPS provider can be used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna

# Optional override; defaults to .venv/bin/python when present.
MIP_ML_PYTHON=.venv/bin/python

HTTP_TIMEOUT=15s
DB_MAX_CONNS=10
DB_MIN_CONNS=2
LOG_LEVEL=info

# Dashboard API and browser app.
API_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# Optional static Webull order-book subscription when `mip serve` starts.
QUOTE_TICKERS=OPK
REDIS_URL=redis://localhost:6379/0

# Always-running daily workflow (Thailand time).
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Bangkok
SCHEDULE_MARKET_SERVICES=14:55
SCHEDULE_MARKET_DAILY_SYNC=13:20
SCHEDULE_NEWS_COVERAGE=07:05
SCHEDULE_AH_OUTCOMES=13:35
SCHEDULE_STRATEGY_REPLAY=13:25
SCHEDULE_MODEL_INFERENCE=14:59
SCHEDULE_PREMARKET_SCAN=15:00
SCHEDULE_RESEARCH=15:00:30
SCHEDULE_RANKING=15:01
SCHEDULE_DASHBOARD_READY=15:02
SCHEDULE_MODEL_LEARNING=13:30
STRATEGY_REPLAY_CANDIDATES=20
STRATEGY_REPLAY_MAX_EVENTS=500000
SCHEDULER_RETRY_ATTEMPTS=3
SCHEDULER_RETRY_DELAY=15s
# Keep the 04:00 ET discovery gate broad. Realtime order flow is still
# mandatory before an entry can execute.
SCANNER_MIN_CHANGE=0
SCANNER_MIN_VOLUME=0
# Rate-limited Massive enrichment for fresh pre-spike flags. The client waits
# 13 seconds between requests so news + float stay below 5 requests/minute.
CANDIDATE_ENRICHMENT_ENABLED=true
CANDIDATE_ENRICHMENT_INTERVAL=30s
CANDIDATE_ENRICHMENT_COOLDOWN=15m
CANDIDATE_ENRICHMENT_CANDIDATE_LIMIT=20
CANDIDATE_NEWS_LOOKBACK=72h
CANDIDATE_NEWS_LIMIT=25
# News-first discovery. Massive reference news is an hourly-updated coverage
# and backfill source. Alpaca WebSocket is the optional realtime fast path.
MARKET_NEWS_MONITOR_ENABLED=true
MARKET_NEWS_MONITOR_INTERVAL=1m
MARKET_NEWS_MONITOR_LOOKBACK=24h
MARKET_NEWS_MONITOR_LIMIT=1000
MARKET_NEWS_ALERT_THRESHOLD=0.75
# Market-wide SEC current filings close the ownership/8-K discovery gap that a
# news vendor can miss. Schedule 13D becomes an ownership catalyst; generic
# 8-K filings are stored and alerted but are not auto-promoted without content.
CURRENT_SEC_MONITOR_ENABLED=true
CURRENT_SEC_MONITOR_INTERVAL=1m
CURRENT_SEC_MONITOR_LOOKBACK=24h
CURRENT_SEC_MONITOR_COUNT=500
# Optional stable seed universe. Watchlist, open positions, selected candidates,
# and QUOTE_TICKERS are added automatically.
SCHEDULER_TICKERS=

# Daily chronological retraining. A new version stays a challenger unless it
# beats the current champion on the same unseen validation dates.
CONTINUOUS_LEARNING_ENABLED=true
CONTINUOUS_LEARNING_MODEL=runner-baseline
CONTINUOUS_LEARNING_ALGORITHM=logistic_v1
CONTINUOUS_LEARNING_ITERATIONS=100
CONTINUOUS_LEARNING_LOOKBACK_DAYS=730
CONTINUOUS_LEARNING_SPIKE_MODEL=spike-discovery-v1
CONTINUOUS_LEARNING_SPIKE_TARGET=spike50
CONTINUOUS_LEARNING_SPIKE_ALGORITHM=lightgbm_v1
CONTINUOUS_LEARNING_SPIKE_BOOST_ROUNDS=64
CONTINUOUS_LEARNING_SPIKE_LOOKBACK_DAYS=730
CONTINUOUS_LEARNING_SPIKE_MIN_RECALL_AT_20=0.10
CONTINUOUS_LEARNING_SPIKE_MIN_RECALL_AT_100=0.40
CONTINUOUS_LEARNING_VALIDATION_FRACTION=0.20
CONTINUOUS_LEARNING_MIN_VALIDATION_SAMPLES=50
CONTINUOUS_LEARNING_MIN_LOGLOSS_IMPROVEMENT=0.01
CONTINUOUS_LEARNING_MAX_PRECISION_REGRESSION=0.03

# Read-only Webull account/position/order synchronization.
BROKER_SYNC_ENABLED=true
BROKER_SYNC_INTERVAL=30s
BROKER_ORDER_DETAIL_INTERVAL=2s

# Execution mode. Paper uses the same autonomous path without broker calls.
TRADING_MODE=paper
# Sessions are order-routing metadata, not candidate-list boundaries.
# Webull uses ALL for pre/regular/after-hours and NIGHT for overnight.
TRADING_ALLOWED_SESSIONS=PRE_MARKET,REGULAR,AFTER_HOURS
PAPER_STARTING_CAPITAL=100000
MAX_POSITION_VALUE=5000
MAX_GROSS_EXPOSURE=0
MAX_CAPITAL_ALLOCATION=0.20
MAX_DAILY_LOSS=500
MAX_RISK_PER_TRADE=200
EXECUTION_APPROVAL_TTL=5m
LOSS_COOLDOWN=30m
# Emergency stop for all new orders, including paper orders.
TRADING_KILL_SWITCH=false

# Deterministic autonomous strategy. Keep TRADING_MODE=paper for forward tests;
# switching to live reuses the same strategy and risk path.
AUTO_TRADING_ENABLED=false
# Hard safety gate for new autonomous broker BUY orders. Keep false until
# shadow stop/exit behavior passes the forward-test certification gate.
AUTO_LIVE_ENTRIES_ENABLED=false
AUTO_MAX_CANDIDATES=2
AUTO_RISK_PER_TRADE=100
AUTO_RETRY_DELAY=30s
AUTO_ENTRY_ORDER_TIMEOUT=5s
# Run the same strategy in an isolated shadow ledger while live execution
# remains governed by broker risk controls. Shadow orders never call the broker.
SHADOW_TRADING_ENABLED=false
SHADOW_MAX_CANDIDATES=10
# Separate 15:55 ET catalyst-boundary forward test. This is always shadow-only:
# it never receives a live broker adapter. The THB cap is shared by all three
# selections, not multiplied per ticker.
BOUNDARY_SHADOW_ENABLED=false
BOUNDARY_SHADOW_MAX_CANDIDATES=3
BOUNDARY_SHADOW_TOTAL_NOTIONAL_THB=100000
BOUNDARY_SHADOW_USD_THB=33.6
# Only catalysts first observed close to the AH boundary are eligible.
# 8h could not see a Friday catalyst that pays on Monday; 72h covers a weekend.
BOUNDARY_SHADOW_NEWS_LOOKBACK=72h
BOUNDARY_SHADOW_MIN_CATALYST=0.75
BOUNDARY_SHADOW_MIN_VOLUME=25000
BOUNDARY_SHADOW_MIN_PRICE=0.20
BOUNDARY_SHADOW_MAX_PRICE=100
BOUNDARY_SHADOW_MAX_SPREAD_PCT=0.03
BOUNDARY_SHADOW_QUOTE_MAX_AGE=30s
BOUNDARY_SHADOW_SIGNAL_MAX_AGE=2m
BOUNDARY_SHADOW_EVALUATION_INTERVAL=5s
BOUNDARY_SHADOW_STOP_LOSS_PCT=0.06
BOUNDARY_SHADOW_TRAIL_START_PCT=0.08
BOUNDARY_SHADOW_TRAIL_DISTANCE_PCT=0.04
BOUNDARY_SHADOW_PROFIT_LOCK_FLOOR_PCT=0.015
# Continuously discover and rerank movers in every tradable session.
CONTINUOUS_SCAN_INTERVAL=15s
CONTINUOUS_SCAN_PAGE_SIZE=100
CONTINUOUS_SCAN_UNIVERSE_SIZE=100
CONTINUOUS_SCAN_SELECTION_LIMIT=10
# Reserve part of the live discovery universe for the latest spike-model Top K.
# These names still need current scanner, order-flow, strategy, and risk confirmation.
CONTINUOUS_SCAN_SPIKE_UNIVERSE_LIMIT=20
SCANNER_MIN_PRICE=0.05
SCANNER_MAX_PRICE=100
SCANNER_MIN_CHANGE=0
SCANNER_MIN_VOLUME=0
STRATEGY_MIN_PULLBACK_PCT=0.02
STRATEGY_MAX_PULLBACK_PCT=0.08
STRATEGY_RECLAIM_PCT=0.01
STRATEGY_MIN_ENTRY_HEADROOM_PCT=0.01
STRATEGY_STOP_LOSS_PCT=0.04
STRATEGY_BREAK_EVEN_START_PCT=0.04
STRATEGY_BREAK_EVEN_BUFFER_PCT=0.003
STRATEGY_PROFIT_LOCK_START_PCT=0.05
STRATEGY_PROFIT_LOCK_FLOOR_PCT=0.015
# Once the live bid reaches +12%, sell 25% once (minimum original position:
# four shares). The remaining position stays under the ratcheting stop.
STRATEGY_PARTIAL_TP_START_PCT=0.12
STRATEGY_PARTIAL_TP_FRACTION=0.25
STRATEGY_PARTIAL_TP_MIN_SHARES=4
STRATEGY_EXIT_FEE_MINIMUM=0.03
STRATEGY_EXIT_FEE_PER_SHARE=0.006
STRATEGY_SLIPPAGE_RESERVE_PCT=0.005
STRATEGY_MINIMUM_NET_PROFIT=0.01
STRATEGY_REENTRY_COOLDOWN=1m
# Promotion gate: keep false while actual-fill replay/shadow validation runs.
STRATEGY_EXIT_MOMENTUM_ENABLED=false
# Reject entries whose conservative profit-lock value cannot leave this much
# after previewed entry fee, estimated exit fee, and slippage reserve.
STRATEGY_MIN_EXPECTED_NET_PROFIT=0.25
STRATEGY_TRAIL_START_PCT=0.08
STRATEGY_TRAIL_DISTANCE_PCT=0.04
# Retention keeps an in-progress setup alive through ranking churn.
# Entries still require the Top AUTO_MAX_CANDIDATES; this only widens
# who may keep working. RANK=0 restores the old drop-on-exit behaviour.
STRATEGY_RETENTION_RANK=30
STRATEGY_RETENTION_GRACE=3m
STRATEGY_MIN_BUYER_PRESSURE=0.55
STRATEGY_MAX_SPREAD_PCT=0.01
STRATEGY_EXIT_LIMIT_BUFFER_PCT=0.002
STRATEGY_QUOTE_MAX_AGE=3s
STRATEGY_TRADE_QUOTE_MAX_LAG=250ms
# Realtime execution confirmation uses both QUOTE order-book updates and
# exchange TICK transactions observed inside this rolling window.
STRATEGY_ORDER_FLOW_WINDOW=5s
STRATEGY_MIN_QUOTE_UPDATES=2
STRATEGY_MIN_TRADE_TICKS=3
STRATEGY_MIN_AGGRESSIVE_BUY_RATIO=0.55
STRATEGY_MIN_UPTICK_RATIO=0.50
STRATEGY_MIN_AVERAGE_BOOK_PRESSURE=0.50
STRATEGY_MIN_PRICE_VELOCITY=0
# Comma-separated symbols whose existing positions must not be auto-exited.
# Tickers followed on every SEC form, not just the market-wide material set.
# Relative volume that admits an after-hours candidate on tape alone.
# Manual ticket ceilings. Enforced server-side because the situation this
# path exists for - a fast tape and no time - is when a size gets mistyped.
TICKET_MAX_RISK=2000
TICKET_MAX_NOTIONAL=40000
TICKET_MIN_SHARE_PRICE=0.20
TICKET_MAX_SHARE_PRICE=100
TICKET_MAX_STOP_DISTANCE=0.10
TICKET_MAX_DAILY_LOSS=6000
TICKET_MAX_PER_DAY=6
BOUNDARY_MIN_RELATIVE_VOLUME=20
FILING_WATCH_PINNED_TICKERS=
STRATEGY_HOLD_TICKERS=
